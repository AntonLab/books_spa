{
  "name": "books_spa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "skills": "skills experimental_install && node scripts/link-skills.mjs",
    "worktree": "node scripts/worktree.mjs",
    "branch:check": "node scripts/branch-check.mjs",
    "tokens": "node scripts/tokens.mjs",
    "baseline": "node scripts/baseline.mjs",
    "layout-lint": "node scripts/layout-lint.mjs",
    "brief:check": "node scripts/brief-check.mjs",
    "dev": "concurrently -n client,server -c cyan,green -k \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces && node scripts/doc-limits.mjs && node scripts/check-doc-refs.mjs",
    "lint:fix": "npm run lint:fix --workspaces",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fallow": "3.38.0",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "skills": "1.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
